{
  "info": {
    "name": "Chat Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection generated from the OpenAPI spec for the chat backend. Base URL: http://localhost:5000"
  },
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/user/create",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "user",
            "create"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Create or Get Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/chat/create",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "chat",
            "create"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userAId\": \"<uuid>\",\n  \"userBId\": \"<uuid>\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Send Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/message/{{chatId}}/message/send",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "message",
            "{{chatId}}",
            "message",
            "send"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"<uuid>\",\n  \"text\": \"Hello world!\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Get Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/message/{{chatId}}/messages?limit=50",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "message",
            "{{chatId}}",
            "messages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Mark Message Read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/message/{{chatId}}/message/{{messageId}}/read",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "message",
            "{{chatId}}",
            "message",
            "{{messageId}}",
            "read"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"<uuid>\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Update Last Seen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/message/{{chatId}}/lastseen",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "message",
            "{{chatId}}",
            "lastseen"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"<uuid>\",\n  \"messageId\": \"<message-id>\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "List User Chats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/user/{{userId}}/chats",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "user",
            "{{userId}}",
            "chats"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "chatId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ]
}